# Animus — filosofía Hermes Agent (https://github.com/nousresearch/hermes-agent)
APP_BRAND_NAME=Animus

# Modo agente: agent loop + tools (como hermes chat)
AGENT_TOOLS_ENABLED=true
APP_BASE_URL=http://localhost:3000
MIND_JWT_SECRET=

# Telegram (gateway)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Supabase (memory + session_search)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM — MiniMax (Hermes lo soporta nativo)
LLM_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.1

# Alternativa: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Cron (local: ./scripts/test-cron.sh · prod: Vercel o crontab)
CRON_SECRET=
SKILL_CURATOR_DAYS=30

# --- Toolsets / integraciones ---

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# Toolset web (SEARCH_PROVIDER=brave|tavily|duckduckgo)
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=

# Voz (BACKLOG)
GROQ_API_KEY=

# Spotify toolset (stub)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/oauth/spotify/callback

# WhatsApp messaging gateway (stub)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
